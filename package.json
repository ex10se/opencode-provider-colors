{
  "name": "opencode-provider-colors",
  "version": "0.1.0",
  "description": "Provider-aware colors for the OpenCode terminal interface",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ex10se/opencode-provider-colors.git"
  },
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": ["dist/**/*.js", "dist/**/*.mjs", "dist/tui.d.ts", "LICENSE", "README.md", "README.ru.md", "CONTRIBUTING.md", "SECURITY.md", "CHANGELOG.md", "docs"],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.mjs",
    "test:dependencies": "node test/dependencies/run.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepack": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@opentui/core": "0.8.1",
    "@types/node": "22.19.0",
    "solid-js": "1.9.18",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
